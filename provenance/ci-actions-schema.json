{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["$schema", "reviewed_on", "actions"],
  "properties": {
    "$schema": {"const": "./ci-actions-schema.json"},
    "reviewed_on": {"type": "string", "format": "date"},
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "source_url", "license", "pinned_revision", "reviewed_on", "use"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "source_url": {"type": "string", "format": "uri"},
          "license": {"type": "string", "minLength": 1},
          "pinned_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "reviewed_on": {"type": "string", "format": "date"},
          "use": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
