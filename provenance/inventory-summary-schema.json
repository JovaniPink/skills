{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jovanipink.com/schemas/capability-inventory-summary-v1.json",
  "title": "Sanitized capability inventory disposition summary",
  "type": "object",
  "required": [
    "$schema",
    "inventory_version",
    "reviewed_on",
    "total_records",
    "review_scope",
    "content_opened",
    "text_copied",
    "implementation_reused",
    "dispositions",
    "domains",
    "reconciliation"
  ],
  "properties": {
    "$schema": {"const": "./inventory-summary-schema.json"},
    "inventory_version": {"const": 1},
    "reviewed_on": {"type": "string", "format": "date"},
    "total_records": {"const": 52},
    "review_scope": {"const": "capability identifiers and paths only"},
    "content_opened": {"const": false},
    "text_copied": {"const": false},
    "implementation_reused": {"const": false},
    "dispositions": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["disposition", "count"],
        "properties": {
          "disposition": {"enum": ["covered", "partial", "public_candidate", "private_overlay", "rejected"]},
          "count": {"type": "integer"}
        },
        "additionalProperties": false
      }
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["domain", "count"],
        "properties": {
          "domain": {"type": "string", "minLength": 1},
          "count": {"type": "integer"}
        },
        "additionalProperties": false
      }
    },
    "reconciliation": {
      "type": "object",
      "required": ["private_ledger_records", "status"],
      "properties": {
        "private_ledger_records": {"const": 52},
        "status": {"const": "matched"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
