{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jovanipink.com/schemas/skill-provenance-v1.json",
  "title": "JovaniPink skill provenance catalog",
  "type": "object",
  "required": ["catalog_version", "reviewed_on", "entries"],
  "properties": {
    "catalog_version": {"const": 1},
    "reviewed_on": {"type": "string", "format": "date"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "skill",
          "disposition",
          "source_url",
          "upstream_license",
          "pinned_revision",
          "reviewed_material",
          "local_changes",
          "security_review",
          "rereview_triggers",
          "revocation"
        ],
        "properties": {
          "skill": {"type": "string"},
          "disposition": {"enum": ["original", "clean-room", "adapted", "vendored", "rejected"]},
          "source_url": {"type": "string"},
          "upstream_license": {"type": "string"},
          "pinned_revision": {"type": "string"},
          "reviewed_material": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "local_changes": {"type": "string"},
          "security_review": {"type": "string"},
          "rereview_triggers": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "revocation": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
