{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["$schema", "audit_version", "reviewed_on", "method", "summary", "sources"],
  "properties": {
    "$schema": {"const": "./public-source-audit-schema.json"},
    "audit_version": {"const": 1},
    "reviewed_on": {"type": "string", "format": "date"},
    "method": {"type": "string", "minLength": 1},
    "summary": {
      "type": "object",
      "required": ["sources", "skill_directories", "bundle_components", "total_components"],
      "properties": {
        "sources": {"const": 2},
        "skill_directories": {"const": 80},
        "bundle_components": {"const": 12},
        "total_components": {"const": 92}
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "source_url",
          "repository_url",
          "branch",
          "pinned_revision",
          "license",
          "license_scope",
          "reviewed_on",
          "content_reviewed",
          "text_copied",
          "structure_copied",
          "implementation_reused",
          "components"
        ],
        "properties": {
          "source_url": {"type": "string", "format": "uri"},
          "repository_url": {"type": "string", "format": "uri"},
          "branch": {"type": "string", "minLength": 1},
          "pinned_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "license": {"const": "MIT"},
          "license_scope": {"type": "string", "minLength": 1},
          "reviewed_on": {"type": "string", "format": "date"},
          "content_reviewed": {"const": true},
          "text_copied": {"const": false},
          "structure_copied": {"const": false},
          "implementation_reused": {"const": false},
          "components": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["path", "component_class", "disposition", "public_mapping", "rationale", "security_notes"],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "component_class": {"enum": ["skill", "bundle"]},
                "disposition": {"enum": ["covered", "partial", "public_candidate", "private_overlay", "rejected"]},
                "public_mapping": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
                },
                "rationale": {"type": "string", "minLength": 1},
                "security_notes": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
