{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["$schema", "catalog_version", "reviewed_on", "max_review_age_days", "sources"],
  "properties": {
    "$schema": {"const": "./upstream-pins-schema.json"},
    "catalog_version": {"const": "0.4.0"},
    "reviewed_on": {"type": "string", "format": "date"},
    "max_review_age_days": {"type": "integer", "minimum": 1},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_url", "content_sha256"],
        "properties": {
          "source_url": {"type": "string", "format": "uri"},
          "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
