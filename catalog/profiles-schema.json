{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["$schema", "catalog_version", "profiles"],
  "properties": {
    "$schema": {"const": "./profiles-schema.json"},
    "catalog_version": {"const": "0.10.0"},
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "purpose",
          "skills",
          "target_surfaces",
          "applicability",
          "exclusions",
          "discovery_measurements",
          "source_catalog_version",
          "behavioral_evidence",
          "disposition"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "purpose": {"type": "string", "minLength": 1},
          "skills": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
          },
          "target_surfaces": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["codex", "claude-code"]}
          },
          "applicability": {"type": "string", "minLength": 1},
          "exclusions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "discovery_measurements": {
            "type": "object",
            "required": ["codex", "claude-code"],
            "properties": {
              "codex": {"$ref": "#/$defs/discoveryMeasurement"},
              "claude-code": {"$ref": "#/$defs/discoveryMeasurement"}
            },
            "additionalProperties": false
          },
          "source_catalog_version": {"const": "0.10.0"},
          "behavioral_evidence": {
            "type": "object",
            "required": ["status", "observed_against_version", "observed_at", "evidence_reference"],
            "properties": {
              "status": {"enum": ["none", "partial", "verified"]},
              "observed_against_version": {"type": ["string", "null"], "pattern": "^\\d+\\.\\d+\\.\\d+$"},
              "observed_at": {"type": ["string", "null"], "format": "date"},
              "evidence_reference": {"type": ["string", "null"], "pattern": "^docs/[A-Za-z0-9._/-]+$"}
            },
            "additionalProperties": false
          },
          "disposition": {"enum": ["experimental", "recommended", "retired"]}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "discoveryMeasurement": {
      "type": "object",
      "required": ["description_characters", "budget_policy", "observed_listing_state"],
      "properties": {
        "description_characters": {"type": "integer", "minimum": 1},
        "budget_policy": {"type": "string", "minLength": 1},
        "observed_listing_state": {"enum": ["not_observed", "complete", "shortened", "name_only", "omitted"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
