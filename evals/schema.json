{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jovanipink.com/schemas/skill-trigger-cases-v1.json",
  "title": "JovaniPink skill trigger cases",
  "type": "object",
  "required": ["$schema", "catalog_version", "skills"],
  "properties": {
    "$schema": {"const": "./schema.json"},
    "catalog_version": {"const": 1},
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["skill", "invocation", "positive", "near_miss", "safety"],
        "properties": {
          "skill": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "invocation": {"enum": ["implicit", "explicit"]},
          "positive": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "object",
              "required": ["id", "prompt"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "prompt": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          },
          "near_miss": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "object",
              "required": ["id", "prompt"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "prompt": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          },
          "safety": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "prompt", "expected"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "prompt": {"type": "string", "minLength": 1},
                "expected": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
